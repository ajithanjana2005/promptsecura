+// Bundles test/*.test.ts with esbuild (same defines as a real build) and
+// runs them, plus test/*.test.mjs, with Node's built-in test runner.
+import * as esbuild from "esbuild";
+import { spawnSync } from "node:child_process";
+import { readdir, rm } from "node:fs/promises";
+import path from "node:path";
+import { fileURLToPath } from "node:url";
+
+import { buildDefines } from "../build.mjs";
+
+const ROOT = path.resolve(path.dirname(fileURLToPath(import.meta.url)), "..");
+const TEST_DIR = path.join(ROOT, "test");
+const OUT_DIR = path.join(ROOT, ".test-dist");
+
+const entries = await readdir(TEST_DIR);
+const tsTests = entries.filter((f) => f.endsWith(".test.ts")).map((f) => path.join(TEST_DIR, f));
+const mjsTests = entries.filter((f) => f.endsWith(".test.mjs")).map((f) => path.join(TEST_DIR, f));
+
+await rm(OUT_DIR, { recursive: true, force: true });
+await esbuild.build({
+  entryPoints: tsTests,
+  outdir: OUT_DIR,
+  outExtension: { ".js": ".mjs" },
+  bundle: true,
+  platform: "node",
+  format: "esm",
+  target: ["node20"],
+  define: buildDefines("http://backend.test", false),
+  logLevel: "warning",
+});
+
+const bundled = tsTests.map((f) => path.join(OUT_DIR, path.basename(f).replace(/\.ts$/, ".mjs")));
+const result = spawnSync(process.execPath, ["--test", ...bundled, ...mjsTests], {
+  stdio: "inherit",
+});
+await rm(OUT_DIR, { recursive: true, force: true });
+process.exit(result.status ?? 1);
diff --git a/extension/src/background/api-client.ts b/extension/src/background/api-client.ts
new file mode 100644
index 0000000..d4d176b
--- /dev/null
+++ b/extension/src/background/api-client.ts
@@ -0,0 +1,179 @@
+/**
+ * Backend API client for POST /api/v1/analyze.
+ *
+ * Runs in the service worker, which has host_permissions for the backend
+ * origin. No chrome.* APIs are used here, so it can be unit-tested with an
+ * injected fetch.
+ *
+ * Fail-closed contract: analyze() never throws and never returns a
+ * decision it did not receive from the backend. Every problem (network,
+ * timeout, non-2xx, malformed body) becomes { ok: false } with the standard
+ * FAIL_CLOSED_MESSAGE.
+ */
+
+import { API_PATHS, FAIL_CLOSED_MESSAGE, REQUEST_TIMEOUT_MS } from "../shared/config";
+import type {
+  AnalysisFailure,
+  AnalysisFailureKind,
+  AnalyzeOutcome,
+  AnalyzeRequest,
+  AnalyzeResponse,
+} from "../shared/types";
+
+export interface ApiClientOptions {
+  baseUrl: string;
+  timeoutMs?: number;
+  fetchImpl?: typeof fetch;
+}
+
+const DECISIONS = new Set(["ALLOW", "SANITIZE", "BLOCK"]);
+const RISK_LEVELS = new Set(["low", "medium", "high"]);
+
+function failure(
+  kind: AnalysisFailureKind,
+  detail: string,
+  status: number | null = null,
+  retryable = true,
+): AnalyzeOutcome {
+  const error: AnalysisFailure = { kind, message: FAIL_CLOSED_MESSAGE, detail, status, retryable };
+  return { ok: false, error };
+}
+
+function isRecord(value: unknown): value is Record<string, unknown> {
+  return typeof value === "object" && value !== null && !Array.isArray(value);
+}
+
+function isString(value: unknown): value is string {
+  return typeof value === "string";
+}
+
+function isNumber(value: unknown): value is number {
+  return typeof value === "number" && Number.isFinite(value);
+}
+
+function isRecordOf<T>(value: unknown, check: (v: unknown) => v is T): boolean {
+  return isRecord(value) && Object.values(value).every(check);
+}
+
+/** Runtime check that a backend body matches AnalyzeResponse. */
+export function isAnalyzeResponse(value: unknown): value is AnalyzeResponse {
+  if (!isRecord(value)) return false;
+  const v = value;
+  const breakdown = v["score_breakdown"];
+  return (
+    isString(v["request_id"]) &&
+    isString(v["decision"]) &&
+    DECISIONS.has(v["decision"]) &&
+    isString(v["risk_level"]) &&
+    RISK_LEVELS.has(v["risk_level"]) &&
+    isNumber(v["risk_score"]) &&
+    v["risk_score"] >= 0 &&
+    v["risk_score"] <= 100 &&
+    Array.isArray(v["reasons"]) &&
+    v["reasons"].every(isString) &&
+    Array.isArray(v["pii_entities"]) &&
+    v["pii_entities"].every(
+      (e) =>
+        isRecord(e) &&
+        isString(e["entity_type"]) &&
+        isNumber(e["start"]) &&
+        isNumber(e["end"]) &&
+        isNumber(e["score"]) &&
+        isString(e["placeholder"]) &&
+        isString(e["source"]),
+    ) &&
+    isRecordOf(v["pii_summary"], isNumber) &&
+    Array.isArray(v["injection_matches"]) &&
+    v["injection_matches"].every(
+      (m) =>
+        isRecord(m) &&
+        isString(m["rule_id"]) &&
+        isString(m["category"]) &&
+        isString(m["description"]) &&
+        isNumber(m["weight"]),
+    ) &&
+    isRecord(breakdown) &&
+    isNumber(breakdown["pii"]) &&
+    isNumber(breakdown["injection"]) &&
+    isNumber(breakdown["obfuscation"]) &&
+    isNumber(breakdown["total"]) &&
+    (v["sanitized_prompt"] === null || isString(v["sanitized_prompt"])) &&
+    isNumber(v["latency_ms"]) &&
+    isRecordOf(v["detectors"], isString)
+  );
+}
+
+function errorCode(body: unknown): string {
+  return isRecord(body) && isString(body["error"]) ? body["error"] : "unknown_error";
+}
+
+function isRetryable(status: number, body: unknown): boolean {
+  if (isRecord(body) && typeof body["retryable"] === "boolean") return body["retryable"];
+  return status >= 500;
+}
+
+export class ApiClient {
+  private readonly baseUrl: string;
+  private readonly timeoutMs: number;
+  private readonly fetchImpl: typeof fetch;
+
+  constructor(options: ApiClientOptions) {
+    this.baseUrl = options.baseUrl.replace(/\/+$/, "");
+    this.timeoutMs = options.timeoutMs ?? REQUEST_TIMEOUT_MS;
+    this.fetchImpl = options.fetchImpl ?? ((input, init) => fetch(input, init));
+  }
+
+  async analyze(request: AnalyzeRequest): Promise<AnalyzeOutcome> {
+    if (typeof request.prompt !== "string" || request.prompt.length === 0) {
+      return failure("invalid_request", "Prompt must be a non-empty string", null, false);
+    }
+
+    const controller = new AbortController();
+    const timer = setTimeout(() => controller.abort(), this.timeoutMs);
+
+    let response: Response;
+    try {
+      response = await this.fetchImpl(this.baseUrl + API_PATHS.analyze, {
+        method: "POST",
+        headers: { "Content-Type": "application/json" },
+        body: JSON.stringify({ prompt: request.prompt, site: request.site }),
+        signal: controller.signal,
+        credentials: "omit",
+        cache: "no-store",
+      });
+    } catch (err) {
+      clearTimeout(timer);
+      if (controller.signal.aborted) {
+        return failure("timeout", `No response within ${this.timeoutMs} ms`);
+      }
+      return failure("network", err instanceof Error ? err.name : "Network request failed");
+    }
+
+    let body: unknown;
+    try {
+      body = await response.json();
+    } catch {
+      if (controller.signal.aborted) {
+        return failure("timeout", `No response within ${this.timeoutMs} ms`);
+      }
+      body = undefined;
+    } finally {
+      clearTimeout(timer);
+    }
+
+    if (!response.ok) {
+      return failure(
+        "http",
+        `HTTP ${response.status}: ${errorCode(body)}`,
+        response.status,
+        isRetryable(response.status, body),
+      );
+    }
+
+    if (!isAnalyzeResponse(body)) {
+      return failure("invalid_response", "Backend response did not match the expected schema");
+    }
+
+    return { ok: true, response: body };
+  }
+}
diff --git a/extension/src/background/service-worker.ts b/extension/src/background/service-worker.ts
new file mode 100644
index 0000000..520d568
--- /dev/null
+++ b/extension/src/background/service-worker.ts
@@ -0,0 +1,102 @@
+/**
+ * PromptSecura service worker (Manifest V3 background).
+ *
+ * Responsibilities:
+ *   - Own all backend communication. The service worker has host_permissions
+ *     for the backend origin; content scripts run in the page's context and
+ *     are subject to the page's CORS/CSP rules, so they never call the
+ *     backend directly.
+ *   - Route messages from extension contexts.
+ *
+ * Phase 3 status: the "promptsecura/analyze" route and API client are in
+ * place, but no content script sends prompts to it yet. Prompt interception
+ * on ChatGPT is a later phase.
+ */
+
+import { BACKEND_URL, FAIL_CLOSED_MESSAGE, SUPPORTED_SITES } from "../shared/config";
+import { log } from "../shared/log";
+import type { AnalyzeOutcome, ExtensionMessage } from "../shared/types";
+import { MessageType } from "../shared/types";
+import { ApiClient } from "./api-client";
+
+const apiClient = new ApiClient({ baseUrl: BACKEND_URL });
+const SUPPORTED_SITE_IDS = new Set<string>(SUPPORTED_SITES.map((s) => s.id));
+
+function isExtensionMessage(value: unknown): value is ExtensionMessage {
+  if (typeof value !== "object" || value === null) return false;
+  const message = value as { type?: unknown; payload?: unknown };
+  if (message.type !== MessageType.Analyze) return false;
+  const payload = message.payload as { prompt?: unknown; site?: unknown } | null | undefined;
+  return (
+    typeof payload === "object" &&
+    payload !== null &&
+    typeof payload.prompt === "string" &&
+    typeof payload.site === "string" &&
+    SUPPORTED_SITE_IDS.has(payload.site)
+  );
+}
+
+async function handleMessage(message: ExtensionMessage): Promise<AnalyzeOutcome> {
+  switch (message.type) {
+    case MessageType.Analyze: {
+      const outcome = await apiClient.analyze(message.payload);
+      // Metadata only: never log prompt text or sanitized text.
+      if (outcome.ok) {
+        log.debug("analysis", {
+          request_id: outcome.response.request_id,
+          decision: outcome.response.decision,
+          risk_score: outcome.response.risk_score,
+          latency_ms: outcome.response.latency_ms,
+        });
+      } else {
+        log.warn("analysis failed (fail-closed)", {
+          kind: outcome.error.kind,
+          status: outcome.error.status,
+        });
+      }
+      return outcome;
+    }
+  }
+}
+
+chrome.runtime.onInstalled.addListener((details) => {
+  log.info(`installed (reason: ${details.reason}), backend: ${BACKEND_URL}`);
+});
+
+chrome.runtime.onMessage.addListener((message: unknown, sender, sendResponse) => {
+  // Only accept messages from this extension's own pages and content scripts.
+  if (sender.id !== chrome.runtime.id) {
+    return false;
+  }
+  if (!isExtensionMessage(message)) {
+    const rejected: AnalyzeOutcome = {
+      ok: false,
+      error: {
+        kind: "invalid_request",
+        message: FAIL_CLOSED_MESSAGE,
+        detail: "Unrecognised or malformed message",
+        status: null,
+        retryable: false,
+      },
+    };
+    sendResponse(rejected);
+    return false;
+  }
+
+  handleMessage(message).then(sendResponse, (err: unknown) => {
+    // ApiClient never throws; this is a last-resort guard that still fails closed.
+    log.error("unexpected error in message handler", err instanceof Error ? err.name : "unknown");
+    const failed: AnalyzeOutcome = {
+      ok: false,
+      error: {
+        kind: "network",
+        message: FAIL_CLOSED_MESSAGE,
+        detail: "Unexpected service worker error",
+        status: null,
+        retryable: true,
+      },
+    };
+    sendResponse(failed);
+  });
+  return true; // keep the message channel open for the async response
+});
