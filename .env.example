# PromptSecura backend configuration. All values are optional; defaults shown.
# Export these in your shell (or Codespace secrets) before starting uvicorn.

# PROMPTSECURA_LOG_LEVEL=INFO
# PROMPTSECURA_SPACY_MODEL=en_core_web_lg           # en_core_web_sm is smaller/faster, less accurate
# PROMPTSECURA_SPACY_MODEL_FALLBACKS=en_core_web_sm # used only if the model above is not installed; empty = none
# PROMPTSECURA_PII_CONTEXTUAL_PHONE=true            # extra detector for bare numbers after "phone", "call", etc.
# PROMPTSECURA_PII_ENTITIES=EMAIL_ADDRESS,PHONE_NUMBER,PERSON,CREDIT_CARD,IP_ADDRESS,URL
# PROMPTSECURA_PII_SCORE_THRESHOLD=0.4
# PROMPTSECURA_INJECTION_RULES_PATH=               # defaults to backend/app/rules/injection_rules.yaml
# PROMPTSECURA_MAX_PROMPT_CHARS=20000
# PROMPTSECURA_ALLOW_MAX=30                        # 0..ALLOW_MAX           -> ALLOW
# PROMPTSECURA_SANITIZE_MAX=60                     # ALLOW_MAX+1..SANITIZE_MAX -> SANITIZE, above -> BLOCK
# PROMPTSECURA_CORS_ORIGINS=                       # comma-separated exact origins
# PROMPTSECURA_CORS_ORIGIN_REGEX=^chrome-extension://[a-p]{32}$   # set empty to disable
