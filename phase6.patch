diff --git a/extension/e2e/fixtures/analyze-server.mjs b/extension/e2e/fixtures/analyze-server.mjs
new file mode 100644
index 0000000..7915a9d
--- /dev/null
+++ b/extension/e2e/fixtures/analyze-server.mjs
@@ -0,0 +1,97 @@
+// TEST FIXTURE — a stand-in for the PromptSecura backend in e2e tests.
+//
+// It speaks the same HTTP contract as POST /api/v1/analyze (see
+// backend/app/schemas/analysis.py) with canned, deterministic decisions:
+//   - text containing "ignore all previous instructions" -> BLOCK (70)
+//   - text containing an email address                   -> SANITIZE (35), with
+//     sanitized_prompt = emails replaced by [EMAIL]
+//   - anything else                                      -> ALLOW (0)
+// It is NOT the real detection pipeline; the backend has its own tests.
+// Modes: "normal", "503" (analysis_unavailable), and stop()/start() for "down".
+import http from "node:http";
+
+const FAIL_MSG = "PromptSecura could not complete the security analysis.";
+const EMAIL = /[\w.+-]+@[\w-]+\.[\w.-]+/g;
+
+function body(decision, score, extra = {}) {
+  return {
+    request_id: `fixture-${Date.now()}`,
+    decision,
+    risk_level: score <= 30 ? "low" : score <= 60 ? "medium" : "high",
+    risk_score: score,
+    reasons: [],
+    pii_entities: [],
+    pii_summary: {},
+    injection_matches: [],
+    score_breakdown: { pii: 0, injection: 0, obfuscation: 0, total: score },
+    sanitized_prompt: null,
+    latency_ms: 1,
+    detectors: { pii: "fixture", injection: "fixture" },
+    ...extra,
+  };
+}
+
+export function decide(prompt) {
+  if (prompt.toLowerCase().includes("ignore all previous instructions")) {
+    return body("BLOCK", 70, {
+      reasons: ["Attempts to make the model ignore or override its previous instructions (rule: instruction_override)"],
+      injection_matches: [
+        {
+          rule_id: "instruction_override",
+          category: "prompt_injection",
+          description: "Attempts to make the model ignore or override its previous instructions",
+          weight: 70,
+        },
+      ],
+    });
+  }
+  const emails = prompt.match(EMAIL);
+  if (emails) {
+    return body("SANITIZE", 35, {
+      pii_summary: { EMAIL_ADDRESS: emails.length },
+      reasons: [`Sensitive information detected: EMAIL_ADDRESS x${emails.length}`],
+      sanitized_prompt: prompt.replace(EMAIL, "[EMAIL]"),
+    });
+  }
+  return body("ALLOW", 0);
+}
+
+export function createAnalyzeServer(port) {
+  const state = { mode: "normal", delayMs: 0, requests: [] };
+  const sockets = new Set();
+  const server = http.createServer((req, res) => {
+    let data = "";
+    req.on("data", (chunk) => (data += chunk));
+    req.on("end", () => {
+      if (req.url !== "/api/v1/analyze" || req.method !== "POST") {
+        res.writeHead(404).end();
+        return;
+      }
+      const prompt = String(JSON.parse(data || "{}").prompt ?? "");
+      state.requests.push({ at: Date.now(), prompt });
+      setTimeout(() => {
+        if (state.mode === "503") {
+          res.writeHead(503, { "Content-Type": "application/json" });
+          res.end(JSON.stringify({ error: "analysis_unavailable", message: FAIL_MSG, retryable: true }));
+          return;
+        }
+        res.writeHead(200, { "Content-Type": "application/json" });
+        res.end(JSON.stringify(decide(prompt)));
+      }, state.delayMs);
+    });
+  });
+  server.on("connection", (socket) => {
+    sockets.add(socket);
+    socket.on("close", () => sockets.delete(socket));
+  });
+
+  return {
+    state,
+    start: () => new Promise((resolve) => server.listen(port, "127.0.0.1", resolve)),
+    stop: () =>
+      new Promise((resolve) => {
+        for (const socket of sockets) socket.destroy();
+        server.close(() => resolve());
+      }),
+  };
+}
diff --git a/extension/e2e/fixtures/chatgpt.html b/extension/e2e/fixtures/chatgpt.html
new file mode 100644
index 0000000..13e8176
--- /dev/null
+++ b/extension/e2e/fixtures/chatgpt.html
@@ -0,0 +1,151 @@
+<!doctype html>
+<!--
+  TEST FIXTURE — an APPROXIMATION of ChatGPT's composer, NOT the real site.
+
+  Served by the e2e tests at https://chatgpt.com/ and https://chat.openai.com/
+  (via request routing; no network access). It models the parts of ChatGPT
+  that PromptSecura's adapter depends on, as publicly observed:
+
+    - <form data-type="unified-composer"> containing a ProseMirror-style
+      contenteditable div#prompt-textarea.ProseMirror with a placeholder
+      paragraph (<p class="placeholder"><br class="ProseMirror-trailingBreak">),
+      plus a hidden fallback <textarea name="prompt-textarea">.
+    - The send button (button#composer-submit-button[data-testid="send-button"])
+      exists only while the box has text; otherwise a voice button is shown.
+      While a reply "streams", a stop button (data-testid="stop-button") is shown.
+    - Enter (without Shift) sends; the editor is cleared asynchronously.
+    - SPA navigation with history.pushState / popstate; each route change
+      remounts the composer (new elements), like a React remount.
+
+  Query options:
+    ?variant=click    send button is type="button" with a click handler
+                      (default: type="submit" + form submit handler)
+    ?markup=fallback  editor has no id/class and the send button only
+                      data-testid (tests the adapter's composer-form fallback)
+    ?stream=MS        simulated reply streaming time (default 700)
+
+  Everything the page "sends" is recorded in window.__sent — this stands in
+  for ChatGPT receiving the prompt.
+-->
+<html lang="en" class="light">
+<head>
+  <meta charset="utf-8" />
+  <title>ChatGPT (PromptSecura test fixture)</title>
+  <style>
+    body { margin: 0; font-family: system-ui, sans-serif; }
+    nav { display: flex; gap: 12px; padding: 12px; border-bottom: 1px solid #eee; }
+    main { height: calc(100vh - 50px); display: flex; flex-direction: column; justify-content: flex-end; }
+    form { margin: 0 auto 24px; width: 700px; border: 1px solid #ccc; border-radius: 24px; padding: 12px; display: flex; gap: 8px; align-items: flex-end; }
+    .editor { flex: 1; min-height: 24px; outline: none; }
+    .editor p { margin: 0; }
+  </style>
+</head>
+<body>
+  <nav>
+    <a href="/" id="new-chat" data-testid="create-new-chat-button">New chat</a>
+    <a href="/gpts" id="nav-gpts">Explore GPTs</a>
+  </nav>
+  <main><div id="composer-root"></div></main>
+  <script>
+    const params = new URLSearchParams(location.search);
+    const VARIANT = params.get("variant") === "click" ? "click" : "submit";
+    const FALLBACK = params.get("markup") === "fallback";
+    const STREAM_MS = Number(params.get("stream") ?? 700);
+    const PLACEHOLDER = '<p data-placeholder="Ask anything" class="placeholder"><br class="ProseMirror-trailingBreak"></p>';
+
+    window.__sent = [];
+    window.__mounts = 0;
+    let chatCounter = 0;
+    let streaming = false;
+    const root = document.getElementById("composer-root");
+
+    const editor = () => root.querySelector('[contenteditable="true"]');
+    const text = () => (editor()?.innerText ?? "").replace(/\n+$/, "");
+
+    function trailingButton() {
+      if (streaming) {
+        return '<button type="button" data-testid="stop-button" aria-label="Stop streaming">■</button>';
+      }
+      if (text().trim()) {
+        const type = VARIANT === "click" ? "button" : "submit";
+        return FALLBACK
+          ? `<button type="${type}" data-testid="send-button">↑</button>`
+          : `<button type="${type}" id="composer-submit-button" aria-label="Send prompt" data-testid="send-button">↑</button>`;
+      }
+      return '<button type="button" data-testid="composer-speech-button" aria-label="Start voice mode">🎤</button>';
+    }
+    function updateButtons() {
+      const slot = root.querySelector(".trailing");
+      if (slot) slot.innerHTML = trailingButton();
+    }
+
+    function send(via) {
+      if (streaming) return;
+      const t = text();
+      if (!t.trim()) return;
+      window.__sent.push({ via, t, path: location.pathname });
+      // React-like: the editor is cleared asynchronously, then a reply streams.
+      setTimeout(() => {
+        const ed = editor();
+        if (ed) ed.innerHTML = PLACEHOLDER;
+        streaming = true;
+        updateButtons();
+        setTimeout(() => { streaming = false; updateButtons(); }, STREAM_MS);
+      }, 30);
+    }
+
+    function mountComposer() {
+      window.__mounts++;
+      const editorAttrs = FALLBACK
+        ? 'class="editor" contenteditable="true"'
+        : 'id="prompt-textarea" class="editor ProseMirror" contenteditable="true" translate="no"';
+      root.innerHTML = `
+        <form class="composer" data-type="unified-composer">
+          <textarea name="prompt-textarea" placeholder="Ask anything" style="display:none"></textarea>
+          <div ${editorAttrs}>${PLACEHOLDER}</div>
+          <span class="trailing"></span>
+        </form>`;
+      updateButtons();
+      const ed = editor();
+      const form = root.querySelector("form");
+      ed.addEventListener("input", () => {
+        ed.querySelector("p.placeholder")?.classList.remove("placeholder");
+        updateButtons();
+      });
+      ed.addEventListener("keydown", (e) => {
+        if (e.key === "Enter" && !e.shiftKey) { e.preventDefault(); send("enter"); }
+      });
+      form.addEventListener("submit", (e) => { e.preventDefault(); send("form"); });
+      form.addEventListener("click", (e) => {
+        const btn = e.target.closest("button");
+        if (!btn) return;
+        if (btn.dataset.testid === "send-button" && VARIANT === "click") send("click");
+        if (btn.dataset.testid === "stop-button") { streaming = false; updateButtons(); }
+      });
+    }
+
+    function render() {
+      if (location.pathname.startsWith("/gpts")) {
+        root.innerHTML = '<p id="gpts-page">Explore GPTs (no composer on this page)</p>';
+      } else {
+        mountComposer();
+      }
+    }
+    function navigate(path) {
+      history.pushState({}, "", path + location.search);
+      render();
+    }
+
+    document.getElementById("new-chat").addEventListener("click", (e) => {
+      e.preventDefault();
+      navigate(`/c/chat-${++chatCounter}`);
+    });
+    document.getElementById("nav-gpts").addEventListener("click", (e) => {
+      e.preventDefault();
+      navigate("/gpts");
+    });
+    window.addEventListener("popstate", render);
+    render();
+  </script>
+</body>
+</html>
diff --git a/extension/e2e/harness.mjs b/extension/e2e/harness.mjs
new file mode 100644
index 0000000..7408279
--- /dev/null
+++ b/extension/e2e/harness.mjs
@@ -0,0 +1,161 @@
+// Shared e2e harness: builds the extension against the fixture backend,
+// launches Chromium with it loaded, and serves the ChatGPT fixture page at the
+// real ChatGPT origins through request routing (no network access needed).
+import { spawnSync } from "node:child_process";
+import { mkdtempSync, readFileSync, rmSync } from "node:fs";
+import os from "node:os";
+import path from "node:path";
+import { fileURLToPath } from "node:url";
+
+import { chromium } from "playwright";
+
+import { createAnalyzeServer } from "./fixtures/analyze-server.mjs";
+
+const ROOT = path.resolve(path.dirname(fileURLToPath(import.meta.url)), "..");
+const OUT = path.join(ROOT, ".e2e-dist");
+const FIXTURE = readFileSync(path.join(ROOT, "e2e", "fixtures", "chatgpt.html"), "utf8");
+export const PORT = 18765;
+export const FAIL_MSG = "PromptSecura could not complete the security analysis.";
+export const sleep = (ms) => new Promise((r) => setTimeout(r, ms));
+
+function buildExtension() {
+  const result = spawnSync(process.execPath, ["build.mjs", `--outdir=${OUT}`], {
+    cwd: ROOT,
+    env: { ...process.env, PROMPTSECURA_BACKEND_URL: `http://127.0.0.1:${PORT}`, PROMPTSECURA_DEBUG: "true" },
+    encoding: "utf8",
+  });
+  if (result.status !== 0) throw new Error(`extension build failed:\n${result.stdout}\n${result.stderr}`);
+}
+
+export async function setup() {
+  buildExtension();
+  const server = createAnalyzeServer(PORT);
+  await server.start();
+  const userDataDir = mkdtempSync(path.join(os.tmpdir(), "promptsecura-e2e-"));
+  const context = await chromium.launchPersistentContext(userDataDir, {
+    channel: "chromium", // full Chromium in new headless mode: supports extensions
+    headless: true,
+    viewport: { width: 1200, height: 800 },
+    executablePath: process.env.PROMPTSECURA_E2E_CHROMIUM || undefined,
+    args: [`--disable-extensions-except=${OUT}`, `--load-extension=${OUT}`],
+  });
+  for (const origin of ["https://chatgpt.com", "https://chat.openai.com"]) {
+    await context.route(`${origin}/**`, (route) =>
+      route.fulfill({ contentType: "text/html", body: FIXTURE }),
+    );
+  }
+  if (!context.serviceWorkers().length) await context.waitForEvent("serviceworker", { timeout: 15000 });
+
+  const allSent = [];
+  const consoleLines = [];
+
+  async function openChat(url = "https://chatgpt.com/") {
+    const page = await context.newPage();
+    const pageLines = [];
+    page.on("console", (m) => {
+      consoleLines.push(m.text());
+      pageLines.push(m.text());
+    });
+    await page.goto(url);
+    const ready = await waitFor(async () => pageLines.some((l) => l.includes("protection active")), 5000);
+    if (!ready) throw new Error(`content script did not start on ${url}`);
+    return new ChatPage(page, allSent, pageLines);
+  }
+
+  async function teardown() {
+    await context.close();
+    await server.stop().catch(() => {});
+    rmSync(userDataDir, { recursive: true, force: true });
+  }
+
+  return { server, context, openChat, teardown, allSent, consoleLines };
+}
+
+export async function waitFor(predicate, timeout = 4000, interval = 40) {
+  const end = Date.now() + timeout;
+  while (Date.now() < end) {
+    if (await predicate()) return true;
+    await sleep(interval);
+  }
+  return false;
+}
+
+/** Page helpers for the ChatGPT fixture. */
+export class ChatPage {
+  constructor(page, allSent, consoleLines) {
+    this.page = page;
+    this.allSent = allSent;
+    this.consoleLines = consoleLines;
+  }
+  editor() {
+    return this.page.locator('form[data-type="unified-composer"] [contenteditable="true"]');
+  }
+  panel() {
+    return this.page.locator("#promptsecura-enforcement-host .panel");
+  }
+  pill() {
+    return this.page.locator("#promptsecura-indicator-host .pill");
+  }
+  async sent() {
+    return this.page.evaluate(() => window.__sent.map((s) => s.t));
+  }
+  /** Records what the page (= ChatGPT) received, for global safety assertions. */
+  async record() {
+    this.allSent.push(...(await this.sent()));
+  }
+  async clear() {
+    await this.editor().click();
+    await this.page.keyboard.press("Control+A");
+    await this.page.keyboard.press("Backspace");
+  }
+  async type(text) {
+    await this.editor().click();
+    await this.page.keyboard.type(text, { delay: 2 });
+  }
+  async setText(text) {
+    await this.clear();
+    await this.type(text);
+  }
+  async enter() {
+    await this.editor().click();
+    await this.page.keyboard.press("End");
+    await this.page.keyboard.press("Enter");
+  }
+  async clickSend() {
+    await this.page.click('[data-testid="send-button"]');
+  }
+  async panelVariant() {
+    return (await this.panel().isVisible().catch(() => false)) ? this.panel().getAttribute("data-variant") : null;
+  }
+  async waitPanel(variant, timeout = 4000) {
+    return waitFor(async () => (await this.panelVariant()) === variant, timeout);
+  }
+  async waitSent(n, timeout = 4000) {
+    return waitFor(async () => (await this.sent()).length >= n, timeout);
+  }
+  async indicatorLabel() {
+    return (await this.pill().isVisible().catch(() => false)) ? this.pill().locator(".label").textContent() : null;
+  }
+  async waitIndicator(label, timeout = 4000) {
+    return waitFor(async () => (await this.indicatorLabel()) === label, timeout);
+  }
+  /** Wait until the fixture's simulated reply has finished streaming. */
+  async waitIdle(timeout = 4000) {
+    return waitFor(async () => (await this.page.locator('[data-testid="stop-button"]').count()) === 0, timeout);
+  }
+  async paste(text) {
+    await this.editor().click();
+    await this.page.evaluate((t) => {
+      const ed = document.querySelector('form[data-type="unified-composer"] [contenteditable="true"]');
+      ed.focus();
+      const dt = new DataTransfer();
+      dt.setData("text/plain", t);
+      ed.dispatchEvent(new ClipboardEvent("paste", { clipboardData: dt, bubbles: true, cancelable: true }));
+      document.execCommand("insertText", false, t);
+    }, text);
+  }
+  async close() {
+    await this.record();
+    await this.page.close();
+  }
+}
